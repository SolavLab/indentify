%% iFEA step 1 - calculate barycentric coordinates
% * for each FEA mesh node, find the corresponding DIC points and avergae their values.
% * this is basically an extension of the barycentric coordinates that uses
% the gross average of many points and not just three in a triangle

%%
clear; close all; clc

saveOn=1;

% Plot settings
fontSize=15;
faceAlpha1=0.6;
faceAlpha2=0.2;
markerSize=40;
markerSize2=5;
lineWidth=3;

%% Import reference configuration
% The input for the reference mesh configuration should come with:
% * meshStruct.nodes
% * meshStruct.F_contact_primary (deformable surface as defined in the
% simulation code)

[file1,runPath1]=uigetfile('','Select reference mesh');
load(fullfile(runPath1,file1)); %ref_mesh.mat (meshStruct)
V = ref_mesh.nodes;
F = ref_mesh.faces;
contact_nodes = unique(F); % Use only nodes on contact surface

%% Import 3D-DIC results of indentation
% The input from MatchID comes as an csv file with the following fields:
% * Coordinates.Image X [Pixel];Coordinates.Image Y [Pixel];
% * trans.X Transformed [mm];trans.Y Transformed [mm];trans.Z Transformed [mm];
% * trans.U Transformed [mm];trans.V Transformed [mm];trans.W Transformed [mm];
% * ext.Current Image [#]; (used to determine point range)

[file2,runPath2]=uigetfile('*.csv','Select DIC data');

f = fullfile(runPath2, file2);
[T,p_names,vars_unique, delimiter] = loadTable(f);

% Arrange data
[im] = getSnapshot(T,vars_unique, delimiter); % DIC data structure ogranized according to individual images.
[P] = getDataPoints(im,p_names,2); % Clean NaN points and reorganize

nPoints = numel(P);
nImages = numel(im);

DIC3D.pos    = zeros(nImages, 3, nPoints);
DIC3D.disp   = zeros(nImages, 3, nPoints);
% DIC3D.strain = DIC3D_data_c(:,7:9,:);

DIC3D.pos(:,1,:) = reshapeFieldData(P, 'transX', nImages, nPoints);
DIC3D.pos(:,2,:) = reshapeFieldData(P, 'transY', nImages, nPoints);
DIC3D.pos(:,3,:) = reshapeFieldData(P, 'transZ', nImages, nPoints);

DIC3D.disp(:,1,:) = reshapeFieldData(P, 'transU', nImages, nPoints);
DIC3D.disp(:,2,:) = reshapeFieldData(P, 'transV', nImages, nPoints);
DIC3D.disp(:,3,:) = reshapeFieldData(P, 'transW', nImages, nPoints);

[file3,runPath3]=uigetfile('*.mat','Select origin translation',runPath2);
if isequal(file3, 0)
    disp('No file selected, continuing without loading origin translation.');
else
    % Load the file if one was selected
    load(fullfile(runPath3, file3), 'origin');
    disp('Origin translation loaded successfully.');
    DIC3D.pos(:,1,:) = DIC3D.pos(:,1,:) - origin(:,1);
    DIC3D.pos(:,2,:) = DIC3D.pos(:,2,:) - origin(:,2);
    DIC3D.pos(:,3,:) = DIC3D.pos(:,3,:) - origin(:,3);
end

%% Determine range of contact nodes to consider
% This section handles the node selection that will be evaluated with the
% given DIC data. Mesh nodes that don't have enough DIC data around them
% are not going to give reliable results and must be ignored.

close all;

% Find average distance between points in cloud to asses density of DIC results
dMat = pdist2(squeeze(DIC3D.pos(1,:,:))',squeeze(DIC3D.pos(1,:,:))');
dMat(dMat==0) = NaN;
DIC_density = mean(min(dMat)); % Calculate the average minimum distance
influenceRadius = DIC_density*3; % Define an influence radius based on DIC density

% Initialize an array to store brush selection indices
brushIndices = zeros(size(contact_nodes));

% Loop through each mesh node to determine if it's within the influence radius
for iNode=1:numel(contact_nodes)
    rel_pos = squeeze(DIC3D.pos(1,:,:))-repmat(V(contact_nodes(iNode),:)',1,nPoints);
    distances = vecnorm(rel_pos);
    if min(distances) < (influenceRadius / 2)
        % mark the node for brushing if it has DIC points close to it
        brushIndices(iNode)=1;
    end
end

continueRunning = true;

while continueRunning
    try
        % Since using the GUI might cause errors:

        % Plot the primary contact faces
        gpatch(F,V,'kw','k',0);
        hold on;

        % Plot with scatterV mesh nodes
        hNodes = scatterV(V(contact_nodes,:), 'filled');

        % Plot with scatter3 all DIC points. Prevent brush selection.
        hDIC = scatter3(squeeze(DIC3D.pos(1,1,:)),squeeze(DIC3D.pos(1,2,:)),squeeze(DIC3D.pos(1,3,:)),'filled');
        set(hDIC, 'HandleVisibility', 'off');
        hDIC.SizeData=markerSize2*0.8;
        hDIC.CData=[0 0 0];
        hDIC.MarkerFaceAlpha=faceAlpha2;

        % Enable brush mode for interactive data selection
        brush on;
        hNodes.BrushData = brushIndices'; % Apply the preselection brush indices to the nodes

        % Finalize the plot with lighting and release the hold
        camlight headlight;
        axis equal
        hold off;
        drawnow;

        % Create a structure and store the initial data
        fig_data.contact_nodes_inROI = contact_nodes;
        fig_data.nNodes = 0; % Initialize nNodes
        fig_data.hNodes = hNodes; % Store the handle to the scatter plot

        % Store the data structure using guidata
        guidata(gcf, fig_data);
        % Create a button within the figure to save the selected points
        btn = uicontrol('Style', 'pushbutton', 'String', 'Save selected points',...
            'Position', [20 20 150 20],...
            'Callback', @saveSelection);
        uiwait % wait for btn to be pressed
        fig_data = guidata(gcf);
        nNodes = fig_data.nNodes;
        contact_nodes_inROI = fig_data.contact_nodes_inROI;
        nodeList = logical(fig_data.nodeList);
        delete(gcf)

        % If the code reaches this point without errors, exit the loop
        continueRunning = false;

    catch ME
        % Handle the error
        disp(['An error occurred: ', ME.message]);

        % Decide whether to continue or break based on the error
        if isempty(fig_data)
            % If the figure has been closed before selection has been saved
            disp('Do not close figure before saving mesh nodes. Trying again...');
        else
            % For other errors, you might want to exit the loop
            continueRunning = false;
        end
    end
end


%% Find barycentric coordinates from reference data to simulation mesh

B = zeros(nNodes,nPoints); %"Barycentric" weights matrix
for iNode=1:nNodes
    rel_pos = squeeze(DIC3D.pos(1,:,:))-repmat(V(contact_nodes_inROI(iNode),:)',1,nPoints);
    distances = vecnorm(rel_pos)+DIC_density/10; %add small value to avoid mesh+DIC points that coincide
    B(iNode,(distances <= influenceRadius)) = 1./distances(distances <= influenceRadius);
    B(iNode,:) = B(iNode,:)/sum(B(iNode,:)); %proportionalize
end

%% Interpolation of experimental results
time = linspace(0,1,nImages);
% Position results in (nNodes)x(nImages)
expResults.pos_out.x.data = B*squeeze(DIC3D.pos(1:nImages,1,:))';
expResults.pos_out.y.data = B*squeeze(DIC3D.pos(1:nImages,2,:))';
expResults.pos_out.z.data = B*squeeze(DIC3D.pos(1:nImages,3,:))';
expResults.pos_out.time = time;
expResults.pos_out.ind = contact_nodes_inROI;
% Displacement results in (nNodes)x(nImages)
expResults.disp_out.ux.data = B*squeeze(DIC3D.disp(1:nImages,1,:))';
expResults.disp_out.uy.data = B*squeeze(DIC3D.disp(1:nImages,2,:))';
expResults.disp_out.uz.data = B*squeeze(DIC3D.disp(1:nImages,3,:))';
expResults.disp_out.time = time;
expResults.disp_out.ind = contact_nodes_inROI;
% % Strain results in (nNodes)x(nImages)
% expResults.strain.Exx.data = B*squeeze(DIC3D.strain(:,1,:))';
% expResults.strain.Eyy.data = B*squeeze(DIC3D.strain(:,2,:))';
% expResults.strain.Exy.data = B*squeeze(DIC3D.strain(:,3,:))';

%%
% Plotting the results using |anim8| to visualize and animate deformations

% Access data
N_disp_mat = zeros(nNodes,3,nImages);
N_disp_mat(:,1,:) = expResults.disp_out.ux.data; %Displacement
N_disp_mat(:,2,:) = expResults.disp_out.uy.data;
N_disp_mat(:,3,:) = expResults.disp_out.uz.data;
timeVec = linspace(0,1,nImages); %Time
DIC_pos = permute(DIC3D.pos,[3 2 1]); %Permute DIC data to match GIBBON data structure

% Create deformed coordinate set
V_DEF=N_disp_mat+repmat(V(contact_nodes_inROI,:),[1 1 nImages]);
Vfull_DEF=repmat(V,[1 1 nImages]);
Vfull_DEF(contact_nodes_inROI,:,:)=N_disp_mat+repmat(V(contact_nodes_inROI,:),[1 1 nImages]);

% Find distance between DIC data and final mesh
meshD = zeros(nNodes,nImages); %distances of node from nearest DIC
for iImage=1:nImages
    meshD(:,iImage) = pdist2(DIC_pos(:,:,iImage),V_DEF(:,:,iImage),'euclidean','Smallest',1);
end

% Create basic view and store graphics handle to initiate animation
hf=cFigure; %Open figure
% gtitle('DIC results: Press play to animate');
% title('Displacements','Interpreter','Latex')
hp1=scatterV(V_DEF(:,:,end),'filled'); %Handle for mesh data to adjust
hp1.SizeData=markerSize;

hold on
hp2=scatterV(DIC_pos(:,:,end),'filled'); %Handle for DIC to adjust
hp2.SizeData=markerSize2;
hp2.MarkerFaceAlpha=faceAlpha1;
hp2.CData = [1,1,1]*0.7;

F_contact_animate = F;
F_contact_animate = F_contact_animate(all(ismember(F, contact_nodes_inROI),2),:);
hp3=gpatch(F_contact_animate,Vfull_DEF(:,:,end),'kw','k',faceAlpha2);

axisGeom(gca,fontSize);
axis(axisLim(DIC3D.pos)); %Set axis limits statically
clim([0 influenceRadius/2]);
cMap = interp1([0;1],[0 0 1; 1 0 0],linspace(0,1,256));
colormap(cMap)
% hColorbar = colorbar;
% title(hColorbar, 'Node position error')

% Set up animation features
animStruct.Time=timeVec; %The time vector
for qt=1:1:size(N_disp_mat,3) %Loop over time increments

    %Set entries in animation structure
    animStruct.Handles{qt}=[hp1 hp1 hp1 hp2 hp2 hp2 hp1 hp3]; %Handles of objects to animate
    animStruct.Props{qt}={'XData','YData','ZData','XData','YData','ZData','CData','Vertices'}; %Properties of objects to animate
    animStruct.Set{qt}={V_DEF(:,1,qt),V_DEF(:,2,qt),V_DEF(:,3,qt),DIC_pos(:,1,qt),DIC_pos(:,2,qt),DIC_pos(:,3,qt),meshD(:,qt),Vfull_DEF(:,:,qt)}; %Property values for to set in order to animate
end
anim8(hf,animStruct); %Initiate animation feature
drawnow;

%% Save barycentric coordinates
if saveOn
    save(fullfile(runPath2,'barycentric_coordinates.mat'),'B');
    save(fullfile(runPath2,'expResults.mat'),'expResults','nodeList');
    disp('expResults.mat saved successfully.');
end

%% Functions

% extract data from P
function pos = reshapeFieldData(P, fieldName, nImages, nPoints)
    % Extract the field values from the structure array and reshape
    pos = reshape([P.(fieldName)], nImages, nPoints);
end

% Define the callback function
function saveSelection(src, ~)
    % Retrieve the data structure from the figure's application data
    fig_data = guidata(src);
    % Retrieve the brushed indices from scatterV
    brushedIndices = fig_data.hNodes.BrushData;
    
    % Update the contact nodes in ROI with the selected brushed indices
    fig_data.contact_nodes_inROI = fig_data.contact_nodes_inROI(brushedIndices > 0);
    fig_data.nodeList = brushedIndices;
    % Count the number of nodes within the ROI
    fig_data.nNodes = numel(fig_data.contact_nodes_inROI);
    
    % Store the updated data back into the figure's application data
    guidata(src, fig_data);
    
    % Resume code
    uiresume
end

